<Project>
  <!--
    Central package management: every NuGet version used by the solution is declared here, exactly once.
    Project files reference packages without a Version attribute. Permissive licenses only (MIT / Apache-2.0 / BSD).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Aspire hosting (AppHost only), all on one version (ADR-0025). The AppHost is a plain Microsoft.NET.Sdk project:
    Aspire.Hosting.AppHost replaces the obsolete Aspire.AppHost.Sdk, Aspire.Hosting.Dotnet provides AddDotnetProject.
    The installed Aspire CLI (the bundle C# AppHosts require) must match this version.
  -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="17.0.0" />
  </ItemGroup>

  <!--
    Infrastructure persistence: EF Core on PostgreSQL through the Aspire Npgsql integration (connection string, retries,
    health check, telemetry), plus snake_case naming (EFCore.NamingConventions, Apache-2.0). EF Core Design is only
    referenced by the Api (the migrations startup project) with PrivateAssets=all.
  -->
  <ItemGroup>
    <!-- Stays on 13.6.5 (ADR-0025): Aspire 17.0.0 ships this package only as a preview (its net11.0 target depends on
         Npgsql EF Core 11 RCs). Client integrations only read the connection string the AppHost injects, so they need not
         match the hosting version. Move to the first stable 17.x when it ships. -->
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.5" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- Data Protection key ring persisted in the console database (ADR-0004; MIT). Same release train as the shared framework. -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
  </ItemGroup>

  <!--
    Infrastructure query cache (ADR-0040 §2, §6-7): FusionCache (MIT) as L1 + Redis L2 + Redis backplane, behind the
    Application's IQueryCache port. The Redis client is StackExchange.Redis (MIT) directly, not Aspire.StackExchange.Redis:
    one multiplexer we create with abortConnect=false serves L2, backplane and the Degraded-only health check, while the
    Aspire client brings its own Unhealthy check and OpenTelemetry 1.18 (we pin 1.17). StackExchange.Redis is pinned to
    the version the FusionCache backplane needs (3.x); Microsoft.Extensions.Caching.StackExchangeRedis (the L2
    IDistributedCache, MIT) declares 2.7.27 as its minimum and runs on it. Caching.StackExchangeRedis stays on the
    shared-framework release train.
  -->
  <ItemGroup>
    <PackageVersion Include="ZiggyCreatures.FusionCache" Version="2.10.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" Version="2.10.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" Version="2.10.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.14" />
    <PackageVersion Include="StackExchange.Redis" Version="3.4.35" />
  </ItemGroup>

  <!-- Api: built-in OpenAPI document generation (/openapi/v1.json), the source of the frontend's generated types. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
  </ItemGroup>

  <!-- Api: Kubernetes proxy forwarding through YARP's IHttpForwarder (ADR-0020; MIT). Targets net8+, runs on net10. -->
  <ItemGroup>
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <!--
    Application layer: validation (FluentValidation, Apache-2.0) and the Microsoft.Extensions packages it may use, the
    abstractions plus Microsoft.Extensions.Options (BACKEND.md allow-list, enforced by ArchitectureTests). They are pinned
    to the lowest 10.0 release, as libraries should; hosts run on the newer shared framework, which wins at runtime.
  -->
  <ItemGroup>
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <!-- IOptions<T> for Application settings classes (e.g. CredentialsOptions); allowed by BACKEND.md since T-0012. -->
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.0" />
  </ItemGroup>

  <!-- ServiceDefaults: OpenTelemetry, service discovery, HTTP resilience. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
  </ItemGroup>

  <!--
    Tests: xUnit v3 run through VSTest (Microsoft.NET.Test.Sdk + xunit.runner.visualstudio) so the documented command
    `dotnet test FleetConsole.slnx` works. The default xunit.v3 4.x package enables Microsoft.Testing.Platform v2, which
    the .NET 10 SDK only runs in MTP mode, and MTP mode rejects a positional solution argument (requires a solution flag).
    xunit.v3.mtp-off is the same framework without the MTP runner. Revisit (ADR) if we switch the whole repo to MTP.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <!-- Api integration tests: in-process host + a real PostgreSQL container (podman via DOCKER_HOST). MIT. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <!-- Query cache adapter tests (ADR-0040): a throwaway Redis for L2 + backplane. MIT. -->
    <PackageVersion Include="Testcontainers.Redis" Version="4.17.0" />
    <!-- Real DI container for dispatcher/behavior tests (the Api tests get it from the ASP.NET Core shared framework). -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <!-- MetricCollector / FakeLogger for Application unit tests (fleet probe metric and log, T-0320). MIT. -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.0.0" />
  </ItemGroup>
</Project>
