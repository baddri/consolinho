<mxfile host="FleetConsole" agent="generated"><diagram id="p0" name="Architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Arc1" value="FleetConsole — one console for ~40 OpenShift clusters" style="text;html=1;fontColor=#151515;fillColor=none;strokeColor=none;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="Arc2" value="Self-hosted, OpenShift-console look and feel. Users log in once; every Kubernetes call is proxied to the selected cluster with the ServiceAccount token an admin assigned to that user." style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;align=left;verticalAlign=middle;fontColor=#4d5258;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1300" height="30" as="geometry"/></mxCell><mxCell id="Arc3" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;FleetConsole web app&lt;br&gt;&lt;font style='font-size:11px'&gt;React · PatternFly 6&lt;br&gt;cluster switcher in the masthead&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Operators &amp;amp; Fleet admins&lt;/i&gt;" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#e7f1fa;strokeColor=#0066cc;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="220" height="150" as="geometry"/></mxCell><mxCell id="Arc4" value="Host OpenShift cluster — namespace consolinho" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;dashed=1;fillColor=none;strokeColor=#6a6e73;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="920" height="870" as="geometry"/></mxCell><mxCell id="Arc5" value="&lt;b&gt;OpenShift Route&lt;/b&gt;&lt;br&gt;edge TLS&lt;br&gt;round-robin,&lt;br&gt;no sticky cookie" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#f5f5f5;strokeColor=#6a6e73;" vertex="1" parent="1"><mxGeometry x="320" y="420" width="160" height="150" as="geometry"/></mxCell><mxCell id="Arc6" value="FleetConsole Deployment — 3–6 identical pods&lt;br&gt;&lt;span style='font-weight:normal;font-size:12px'&gt;HPA on CPU (70 % of 250m) · PDB · spread over nodes · stateless&lt;/span&gt;" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;dashed=1;fillColor=none;strokeColor=#6a6e73;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;strokeColor=#0066cc;" vertex="1" parent="1"><mxGeometry x="520" y="150" width="470" height="600" as="geometry"/></mxCell><mxCell id="Arc7" value="&lt;b&gt;Web app hosting&lt;/b&gt; — built SPA served as static files" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#e7f1fa;strokeColor=#0066cc;" vertex="1" parent="1"><mxGeometry x="540" y="215" width="430" height="45" as="geometry"/></mxCell><mxCell id="Arc8" value="&lt;b&gt;API&lt;/b&gt; (ASP.NET Core, .NET 10)&lt;br&gt;&lt;font style='font-size:11px'&gt;/api/auth · /api/admin (users, clusters, credentials, grants, audit) · /api/clusters&lt;/font&gt;" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#e7f1fa;strokeColor=#0066cc;" vertex="1" parent="1"><mxGeometry x="540" y="270" width="430" height="60" as="geometry"/></mxCell><mxCell id="Arc9" value="&lt;b&gt;Kubernetes proxy&lt;/b&gt; (YARP) — /api/clusters/{cluster}/k8s/**&lt;br&gt;&lt;font style='font-size:11px'&gt;resolve user's grant → policies: read-only guard, audit → strip browser credentials → add Bearer &amp;lt;SA token&amp;gt; → stream (watch, logs, exec over WebSocket)&lt;/font&gt;" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#0066cc;strokeColor=#004080;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="540" y="340" width="430" height="95" as="geometry"/></mxCell><mxCell id="Arc10" value="&lt;b&gt;Application&lt;/b&gt; — commands &amp;amp; queries (CQRS)&lt;br&gt;&lt;font style='font-size:11px'&gt;pipeline: validation · authorization · transactions · audit&lt;/font&gt;" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#f2f0fc;strokeColor=#5e40be;" vertex="1" parent="1"><mxGeometry x="540" y="445" width="430" height="60" as="geometry"/></mxCell><mxCell id="Arc11" value="&lt;b&gt;Domain&lt;/b&gt; — User · Cluster · Credential · Grant · Audit entry&lt;br&gt;&lt;font style='font-size:11px'&gt;business rules live here, no framework code&lt;/font&gt;" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#f2f0fc;strokeColor=#5e40be;" vertex="1" parent="1"><mxGeometry x="540" y="515" width="430" height="55" as="geometry"/></mxCell><mxCell id="Arc12" value="&lt;b&gt;Infrastructure&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;EF Core / PostgreSQL · Data Protection (encrypts SA tokens and session cookies, key ring shared by all pods) · one HTTPS client per managed cluster with its own CA&lt;/font&gt;" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#f2f0fc;strokeColor=#5e40be;" vertex="1" parent="1"><mxGeometry x="540" y="580" width="430" height="70" as="geometry"/></mxCell><mxCell id="Arc13" value="&lt;font style='font-size:11px'&gt;&lt;b&gt;Layering:&lt;/b&gt; Api → Application → Domain ← Infrastructure&lt;br&gt;Observability: OpenTelemetry traces/metrics, /health readiness, /alive liveness&lt;/font&gt;" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=4;fontSize=13;align=left;verticalAlign=top;spacing=12;fillColor=#ffffff;strokeColor=#d2d2d2;" vertex="1" parent="1"><mxGeometry x="540" y="660" width="360" height="75" as="geometry"/></mxCell><mxCell id="Arc14" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;users · clusters · &lt;b&gt;encrypted&lt;/b&gt; SA tokens · grants (read-only / read-write) · append-only audit log · Data Protection key ring&lt;/font&gt;" style="shape=cylinder3;fontColor=#151515;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fontSize=13;fillColor=#fdf7e7;strokeColor=#c58c00;" vertex="1" parent="1"><mxGeometry x="570" y="800" width="400" height="140" as="geometry"/></mxCell><mxCell id="Arc15" value="&lt;b&gt;OpenShift OAuth server&lt;/b&gt;&lt;br&gt;of the host cluster&lt;br&gt;&lt;font style='font-size:11px'&gt;login only — the OAuth token is discarded after reading the username&lt;/font&gt;" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#f3faf2;strokeColor=#3e8635;" vertex="1" parent="1"><mxGeometry x="1030" y="180" width="160" height="130" as="geometry"/></mxCell><mxCell id="Arc16" value="~40 managed OpenShift clusters" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;dashed=1;fillColor=none;strokeColor=#6a6e73;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;strokeColor=#3e8635;" vertex="1" parent="1"><mxGeometry x="1270" y="260" width="330" height="500" as="geometry"/></mxCell><mxCell id="Arc17" value="&lt;b&gt;Cluster A&lt;/b&gt; — API server :6443&lt;br&gt;&lt;font style='font-size:11px'&gt;ServiceAccount(s) whose tokens the admin registered in FleetConsole; RBAC on the cluster still applies&lt;/font&gt;" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#f3faf2;strokeColor=#3e8635;" vertex="1" parent="1"><mxGeometry x="1300" y="320" width="270" height="95" as="geometry"/></mxCell><mxCell id="Arc18" value="&lt;b&gt;Cluster B&lt;/b&gt; — API server :6443" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#f3faf2;strokeColor=#3e8635;" vertex="1" parent="1"><mxGeometry x="1300" y="435" width="270" height="70" as="geometry"/></mxCell><mxCell id="Arc19" value="&lt;b&gt;Cluster C&lt;/b&gt; — API server :6443" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#f3faf2;strokeColor=#3e8635;" vertex="1" parent="1"><mxGeometry x="1300" y="525" width="270" height="70" as="geometry"/></mxCell><mxCell id="Arc20" value="…&lt;br&gt;&lt;font style='font-size:11px'&gt;prod / staging / dev, each with its own CA bundle and credentials&lt;/font&gt;" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#f5f5f5;strokeColor=#6a6e73;dashed=1;" vertex="1" parent="1"><mxGeometry x="1300" y="615" width="270" height="120" as="geometry"/></mxCell><mxCell id="Arc21" value="HTTPS&lt;br&gt;session cookie" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Arc3" target="Arc5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Arc22" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;entryX=0;entryY=0.5;" edge="1" parent="1" source="Arc5" target="Arc8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Arc23" value="HTTPS + Bearer SA token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="Arc9" target="Arc17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Arc24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6;entryX=0;entryY=0.5;" edge="1" parent="1" source="Arc9" target="Arc18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Arc25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.9;entryX=0;entryY=0.5;" edge="1" parent="1" source="Arc9" target="Arc19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Arc26" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.9186;exitY=1;entryX=0.9125;entryY=0;" edge="1" parent="1" source="Arc12" target="Arc14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Arc27" value="server-side&lt;br&gt;auth code flow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="Arc8" target="Arc15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Arc28" value="login redirect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeWidth=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="Arc3" target="Arc15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="100"/><mxPoint x="1110" y="100"/></Array></mxGeometry></mxCell><mxCell id="Arc29" value="&lt;b&gt;Why it is safe&lt;/b&gt;&lt;ul style='margin:6px 0 0 -18px'&gt;&lt;li&gt;One login (OpenShift OAuth) for every cluster&lt;/li&gt;&lt;li&gt;Admins decide who gets which cluster, read-only or read-write&lt;/li&gt;&lt;li&gt;SA tokens encrypted at rest, never sent to the browser&lt;/li&gt;&lt;li&gt;Read-only grants enforced in the proxy before the request leaves&lt;/li&gt;&lt;li&gt;Every change through the proxy and every admin action is audited&lt;/li&gt;&lt;li&gt;Cluster RBAC still applies on top&lt;/li&gt;&lt;/ul&gt;" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=4;fontSize=13;align=left;verticalAlign=top;spacing=12;fillColor=#ffffff;strokeColor=#d2d2d2;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="230" height="370" as="geometry"/></mxCell><mxCell id="Arc30" value="&lt;b&gt;Stack&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;.NET 10 · ASP.NET Core · YARP · EF Core · PostgreSQL · React · TypeScript · PatternFly 6 · TanStack Query&lt;br&gt;&lt;br&gt;One container image (API + web app), deployed with kustomize; local dev via .NET Aspire.&lt;/font&gt;" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=4;fontSize=13;align=left;verticalAlign=top;spacing=12;fillColor=#ffffff;strokeColor=#d2d2d2;" vertex="1" parent="1"><mxGeometry x="1270" y="800" width="330" height="180" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="Proxy request flow"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pro1" value="What happens when a user opens “Pods” on cluster B" style="text;html=1;fontColor=#151515;fillColor=none;strokeColor=none;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="Pro2" value="&lt;b&gt;1. Browser&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;GET /api/clusters/cluster-b/k8s/api/v1/namespaces/shop/pods&lt;br&gt;(session cookie)&lt;/font&gt;" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#e7f1fa;strokeColor=#0066cc;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="195" height="170" as="geometry"/></mxCell><mxCell id="Pro3" value="&lt;b&gt;2. Authenticate&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Session cookie → current user (active, role)&lt;/font&gt;" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#f2f0fc;strokeColor=#5e40be;" vertex="1" parent="1"><mxGeometry x="265" y="120" width="195" height="170" as="geometry"/></mxCell><mxCell id="Pro4" value="&lt;b&gt;3. Resolve access&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;User + cluster → grant → credential: API URL, CA bundle, decrypted SA token, read-only / read-write&lt;/font&gt;" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#f2f0fc;strokeColor=#5e40be;" vertex="1" parent="1"><mxGeometry x="490" y="120" width="195" height="170" as="geometry"/></mxCell><mxCell id="Pro5" value="&lt;b&gt;4. Policies&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Read-only guard (blocks writes and exec on read-only grants) · audit marks mutations&lt;/font&gt;" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#f2f0fc;strokeColor=#5e40be;" vertex="1" parent="1"><mxGeometry x="715" y="120" width="195" height="170" as="geometry"/></mxCell><mxCell id="Pro6" value="&lt;b&gt;5. Rewrite&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Drop browser cookie, Authorization and Impersonate-* headers; add Bearer &amp;lt;SA token&amp;gt;&lt;/font&gt;" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#0066cc;strokeColor=#004080;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="940" y="120" width="195" height="170" as="geometry"/></mxCell><mxCell id="Pro7" value="&lt;b&gt;6. Forward &amp;amp; stream&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;YARP streams to the cluster API server — watches, logs and exec are never buffered&lt;/font&gt;" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#0066cc;strokeColor=#004080;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1165" y="120" width="195" height="170" as="geometry"/></mxCell><mxCell id="Pro8" value="&lt;b&gt;7. Record&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Audit entry for mutations (who, cluster, verb, path, status)&lt;/font&gt;" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#fdf7e7;strokeColor=#c58c00;" vertex="1" parent="1"><mxGeometry x="1390" y="120" width="195" height="170" as="geometry"/></mxCell><mxCell id="Pro9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Pro2" target="Pro3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Pro10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Pro3" target="Pro4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Pro11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Pro4" target="Pro5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Pro12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Pro5" target="Pro6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Pro13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Pro6" target="Pro7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Pro14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Pro7" target="Pro8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Pro15" value="&lt;b&gt;Denied&lt;/b&gt; → 403 with a reason the UI shows (e.g. “read-only access to cluster B”)" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#faeae8;strokeColor=#c9190b;" vertex="1" parent="1"><mxGeometry x="625" y="360" width="240" height="90" as="geometry"/></mxCell><mxCell id="Pro16" value="deny" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#c9190b;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="Pro5" target="Pro15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Pro17" value="&lt;b&gt;Cluster B API server&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;its own RBAC decides for the ServiceAccount&lt;/font&gt;" style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#f3faf2;strokeColor=#3e8635;" vertex="1" parent="1"><mxGeometry x="1390" y="360" width="240" height="90" as="geometry"/></mxCell><mxCell id="Pro18" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="Pro7" target="Pro17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Pro19" value="Each pod caches one HTTPS client per cluster (its own CA validation). Pods hold no session state: sessions are encrypted cookies and the key ring is shared via PostgreSQL, so any pod can serve any request; long-lived streams stay on the pod where they opened." style="html=1;fontColor=#151515;whiteSpace=wrap;rounded=1;arcSize=4;fontSize=13;align=left;verticalAlign=top;spacing=12;fillColor=#ffffff;strokeColor=#d2d2d2;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1590" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
