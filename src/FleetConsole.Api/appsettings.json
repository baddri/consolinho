{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Proxy": {
    "RequestTimeout": "00:00:30",
    "WatchTimeoutCap": "00:05:00",
    "StreamIdleSlack": "00:00:30",
    "ExecSessionCap": "01:00:00",
    "MaxMutationBodyBytes": 10485760
  },
  "Cache": {
    "Duration": "00:00:30"
  },
  "Fleet": {
    "MaxClusterConcurrency": 10,
    "ClusterTimeout": "00:00:05",
    "CacheDuration": "00:00:30",
    "MaxConcurrentRequests": 16,
    "RequestQueueLimit": 64
  }
}
