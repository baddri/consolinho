<Project Sdk="Microsoft.NET.Sdk">
  <!-- Adapters for Application ports: EF Core persistence, token protection, per-cluster HTTP clients. -->
  <PropertyGroup>
    <RootNamespace>FleetConsole.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Api.Tests exercises internal persistence plumbing (domain event collection, model conventions) directly. -->
    <InternalsVisibleTo Include="FleetConsole.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <!-- IHttpClientFactory for the "openshift-host" client, and RemoveAllResilienceHandlers to opt it out of the
         ServiceDefaults retries (single-use OAuth codes must never be replayed). Version shared with ServiceDefaults. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <!-- Query cache (ADR-0040): FusionCache L1 + Redis L2/backplane on one StackExchange.Redis multiplexer. -->
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="ZiggyCreatures.FusionCache" />
    <PackageReference Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" />
    <PackageReference Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FleetConsole.Application\FleetConsole.Application.csproj" />
    <ProjectReference Include="..\FleetConsole.Domain\FleetConsole.Domain.csproj" />
  </ItemGroup>
</Project>
